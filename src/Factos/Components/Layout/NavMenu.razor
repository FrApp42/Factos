<div class="top-row">
    <a class="brand" href="admin/dashboard"><Factos.Components.Shared.BrandMark />@Loc.T("Factos")</a>
</div>

<input type="checkbox" title="@Loc.T("Menu")" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column py-2">
        <AuthorizeView>
            <Authorized>
                @foreach (var (href, label, icon) in Links)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@href"><svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)icon)</svg>@Loc.T(label)</NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

