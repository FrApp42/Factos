<div class="top-row">
    <a class="brand" href="admin/dashboard"><Factos.Components.Shared.BrandMark />@Loc.T("Factos")</a>
</div>

<input type="checkbox" title="@Loc.T("Menu")" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column py-2">
        <AuthorizeView>
            <Authorized>
                @foreach (var (href, label) in Links)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@href">@Loc.T(label)</NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly (string, string)[] Links =
    [
        ("admin/dashboard", "Tableau de bord"),
        ("admin/customers", "Clients"),
        ("admin/items", "Articles"),
        ("admin/estimates", "Devis"),
        ("admin/invoices", "Factures"),
        ("admin/recurring-invoices", "Factures récurrentes"),
        ("admin/payments", "Paiements"),
        ("admin/expenses", "Dépenses"),
        ("admin/suppliers", "Fournisseurs"),
        ("admin/settings", "Paramètres"),
    ];
}
