@* The document as the customer sees it: admin view and public page. *@
<div class="card"><div class="card-body p-4">
    <div class="d-flex justify-content-between mb-4 gap-3 flex-wrap">
        <div>
            @if (!string.IsNullOrEmpty(D.Company.Logo))
            {
                <img src="/logos/@D.Company.UniqueHash" alt="@D.Company.Name" style="max-height:60px;max-width:220px" class="mb-2 d-block" />
            }
            <div class="fs-4 fw-bold">@D.Company.Name</div>
            @foreach (var line in DocumentData.Lines(D.CompanyAddress, D.CompanyCountry)) { <div class="small">@line</div> }
            @if (!string.IsNullOrEmpty(D.Company.VatId)) { <div class="small">@Loc.F("TVA : {0}", D.Company.VatId)</div> }
        </div>
        <div class="text-end">
            <div class="fs-3 text-uppercase text-muted">@D.Title</div>
            <div><strong>@Loc.T("N° :")</strong> @D.Number</div>
            <div><strong>@Loc.T("Date :")</strong> @D.FormatDate(D.Date)</div>
            @if (D.DueDate is not null) { <div><strong>@(D.Kind == DocumentData.Invoice ? Loc.T("Échéance") : Loc.T("Valable jusqu'au")) :</strong> @D.FormatDate(D.DueDate)</div> }
            @if (D.IsCreditNote) { <div><strong>@Loc.T("Avoir sur la facture :")</strong> @D.RelatedNumber</div> }
            else if (!string.IsNullOrEmpty(D.Reference)) { <div><strong>@Loc.T("Réf. :")</strong> @D.Reference</div> }
            @if (!string.IsNullOrEmpty(D.CreditReason)) { <div><strong>@Loc.T("Motif :")</strong> @D.CreditReason</div> }
        </div>
    </div>

    <div class="mb-4">
        <div class="text-muted small">@(D.Kind switch { DocumentData.Payment => Loc.T("Reçu de"), DocumentData.Expense => Loc.T("Client"), _ => Loc.T("Facturé à") })</div>
        <div class="fw-semibold">@D.Customer.Name</div>
        @foreach (var line in DocumentData.Lines(D.BillingAddress, D.BillingCountry)) { <div class="small">@line</div> }
        @if (!string.IsNullOrEmpty(D.Customer.TaxId)) { <div class="small">@Loc.F("TVA : {0}", D.Customer.TaxId)</div> }
    </div>

    @if (!D.HasLines)
    {
        <div class="p-3 bg-light rounded mb-3">
            <div class="fs-5 fw-bold">@(D.Kind == DocumentData.Expense ? Loc.T("Montant") : Loc.T("Montant reçu")) : @D.Money(D.Amount)</div>
            @if (!string.IsNullOrEmpty(D.Category)) { <div>@Loc.F("Catégorie : {0}", D.Category)</div> }
            @if (!string.IsNullOrEmpty(D.PaymentMethod)) { <div>@Loc.F("Moyen de paiement : {0}", D.PaymentMethod)</div> }
        </div>
        @if (D.PaidInvoices.Count > 0)
        {
            <table class="table">
                <thead><tr><th>@Loc.T("Facture")</th><th class="money">@Loc.T("Montant réglé")</th></tr></thead>
                <tbody>@foreach (var (number, amount) in D.PaidInvoices) { <tr><td>@number</td><td class="money">@D.Money(amount)</td></tr> }</tbody>
            </table>
        }
    }
    else
    {
        <table class="table">
            <thead><tr><th>@Loc.T("Désignation")</th><th class="money">@Loc.T("Qté")</th><th class="money">@Loc.T("Prix")</th>
                @if (D.DiscountPerItem) { <th class="money">@Loc.T("Remise")</th> }
                @if (D.TaxPerItem) { <th class="money">@Loc.T("Taxes")</th> }
                <th class="money">@Loc.T("Montant")</th></tr></thead>
            <tbody>
                @foreach (var line in D.Items)
                {
                    <tr>
                        <td><div>@line.Name</div>@if (!string.IsNullOrEmpty(line.Description)) { <div class="small text-muted" style="white-space:pre-line">@line.Description</div> }</td>
                        <td class="money">@line.Quantity.ToString("0.##") @line.UnitName</td>
                        <td class="money">@D.Money(line.Price)</td>
                        @if (D.DiscountPerItem) { <td class="money">@D.Money(line.DiscountVal)</td> }
                        @if (D.TaxPerItem) { <td class="money">@D.Money(line.Tax)</td> }
                        <td class="money">@D.Money(line.Total)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="row">
        <div class="col-md-6" style="white-space:pre-line">@D.Notes</div>
        @if (D.HasLines)
        {
            <div class="col-md-6">
                <table class="table table-sm">
                    <tr><td>Sous-total</td><td class="money">@D.Money(D.SubTotal)</td></tr>
                    @if (D.DiscountVal != 0) { <tr><td>@Loc.T("Remise")</td><td class="money">- @D.Money(D.DiscountVal)</td></tr> }
                    @foreach (var t in D.Taxes) { <tr><td>@t.Name @(t.Percent is { } p ? $"({p:0.##} %)" : "")</td><td class="money">@D.Money(t.Amount)</td></tr> }
                    <tr class="fw-bold"><td>@Loc.F("Total {0}", (D.TaxIncluded ? "(TTC, taxes incluses)" : ""))</td><td class="money">@D.Money(D.Total)</td></tr>
                    @if (D.Kind == DocumentData.Invoice && !D.IsCreditNote && D.DueAmount != D.Total) { <tr><td>@Loc.T("Reste à payer")</td><td class="money">@D.Money(D.DueAmount)</td></tr> }
                </table>
            </div>
        }
    </div>
</div></div>

@code {
    [Parameter, EditorRequired] public DocumentData D { get; set; } = default!;
}
