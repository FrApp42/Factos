@* The Factos tile in the active theme's colours: an invoice with a folded corner, its lines drawing the F.
   wwwroot/favicon.svg is the same art in the default theme. *@
<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <defs>
        <linearGradient id="brand-mark-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color: var(--hero-to)" />
            <stop offset="1" style="stop-color: var(--hero-from)" />
        </linearGradient>
    </defs>
    <rect width="48" height="48" rx="11" fill="url(#brand-mark-gradient)" />
    <path d="M14 11.5a2.5 2.5 0 0 1 2.5-2.5H28l7 7v20.5a2.5 2.5 0 0 1-2.5 2.5h-16a2.5 2.5 0 0 1-2.5-2.5z" fill="#fff" />
    <path d="M28 9v4.5a2.5 2.5 0 0 0 2.5 2.5H35z" style="fill: var(--hero-to)" opacity=".45" />
    <path d="M20.5 32V18.5h7.5M20.5 25h5.5" fill="none" style="stroke: var(--hero-from)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
