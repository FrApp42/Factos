@page "/Account/ForgotPassword"
@layout Factos.Components.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using Factos.Domain
@inject PasswordResets Resets
@inject NavigationManager Navigation

<PageTitle>@Loc.T("Mot de passe oublié · Factos")</PageTitle>

<h1 class="h5 mb-3 text-center">@Loc.T("Mot de passe oublié")</h1>

@if (requested)
{
    <div class="alert alert-info">@Loc.T("Si un compte existe pour cette adresse, un e-mail avec un lien de réinitialisation vient d'être envoyé.")</div>
    <a href="Account/Login">@Loc.T("Retour à la connexion")</a>
}
else
{
    <p class="small text-muted">@Loc.T("Indiquez votre e-mail : vous recevrez un lien pour choisir un nouveau mot de passe.")</p>
    <EditForm Model="Input" FormName="forgot-password" method="post" OnValidSubmit="Send">
        <DataAnnotationsValidator />
        <label class="d-block mb-3"><span class="form-label d-block">E-mail</span>
            <InputText class="form-control" @bind-Value="Input.Email" autocomplete="username" /></label>
        <ValidationMessage For="() => Input.Email" class="text-danger" />
        <button class="w-100 btn btn-primary" type="submit">@Loc.T("Envoyer le lien")</button>
    </EditForm>
    <div class="mt-3 text-center"><a href="Account/Login">@Loc.T("Retour à la connexion")</a></div>
}

@code {
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;
    private bool requested;

    protected override void OnInitialized() => Input ??= new();

    private async Task Send()
    {
        await Resets.RequestAsync(Input.Email, Navigation.BaseUri);
        requested = true;
    }

    private sealed class InputModel
    {
        [LocRequired(ErrorMessage = "L'e-mail est obligatoire.")]
        [LocEmail(ErrorMessage = "E-mail invalide.")]
        public string Email { get; set; } = "";
    }
}
